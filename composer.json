{
    "name": "dotproject/dotproject",
    "description": "Sistema de Gerenciamento de Projetos Open Source",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "doctrine/annotations": "^2.0",
        "doctrine/dbal": "^4.4",
        "doctrine/orm": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "DotProject\\": "src/"
        },
        "classmap": [
            "classes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DotProject\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
